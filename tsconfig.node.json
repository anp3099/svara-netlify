{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,

    "types": ["node"],

    "noEmit": false,
    "outDir": ".netlify/functions-compiled"
  },
  "include": ["netlify/functions/**/*.ts", "vite.config.ts"]
}
